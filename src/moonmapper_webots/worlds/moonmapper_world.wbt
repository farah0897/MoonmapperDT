#VRML_SIM R2022b utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/solids/protos/Box.proto"

WorldInfo {
  basicTimeStep 16
  FPS 60
  optimalThreadCount 4
  physicsDisableTime 0.1
  physicsDisableAngularThreshold 0.1
  physicsDisableLinearThreshold 0.1
}

Viewpoint {
  orientation -0.4 -0.2 0.9 2.0
  position 4 3 2
  follow "moonmapper_rover"
}

TexturedBackground {
  texture "mars"
}

TexturedBackgroundLight {
  texture "mars"
}

Floor {
  translation 0 0 0
  size 20 20
  name "sand_floor"
}

Box {
  translation 2 1 0.25
  size 0.5 0.5 0.5
  name "obstacle_1"
}

Box {
  translation -1.5 -2 0.25
  size 0.6 0.4 0.5
  name "obstacle_2"
}

Box {
  translation 0 3 0.2
  size 0.4 0.4 0.4
  name "obstacle_3"
}

Robot {
  children [
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.125 0.175 0.04
      }
      device [ RotationalMotor { name "left_front_motor" } ]
      endPoint Solid {
        translation 0.125 0.175 0.04
        children [
          DEF WHEEL Transform {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.2 0.2 0.2
                  roughness 1
                  metalness 0
                }
                geometry Cylinder { height 0.04 radius 0.08 }
              }
            ]
          }
        ]
        name "left_front_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.175 0.04
      }
      device [ RotationalMotor { name "left_center_motor" } ]
      endPoint Solid {
        translation 0 0.175 0.04
        children [ USE WHEEL ]
        name "left_center_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.125 0.175 0.04
      }
      device [ RotationalMotor { name "left_rear_motor" } ]
      endPoint Solid {
        translation -0.125 0.175 0.04
        children [ USE WHEEL ]
        name "left_rear_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.125 -0.175 0.04
      }
      device [ RotationalMotor { name "right_front_motor" } ]
      endPoint Solid {
        translation 0.125 -0.175 0.04
        children [ USE WHEEL ]
        name "right_front_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.175 0.04
      }
      device [ RotationalMotor { name "right_center_motor" } ]
      endPoint Solid {
        translation 0 -0.175 0.04
        children [ USE WHEEL ]
        name "right_center_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.125 -0.175 0.04
      }
      device [ RotationalMotor { name "right_rear_motor" } ]
      endPoint Solid {
        translation -0.125 -0.175 0.04
        children [ USE WHEEL ]
        name "right_rear_wheel"
        boundingObject USE WHEEL
        physics Physics { }
      }
    }
    Transform {
      translation 0 0 0.1
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.4 0.4 0.45
            roughness 1
            metalness 0
          }
          geometry Box { size 0.5 0.4 0.12 }
        }
      ]
    }
    Lidar {
      translation 0.15 0 0.16
      rotation 0 1 0 1.5708
      name "lidar"
      numberOfLayers 1
      horizontalResolution 360
      fieldOfView 6.28318
      minRange 0.1
      maxRange 10.0
      type "fixed"
    }
  ]
  boundingObject Transform {
    translation 0 0 0.1
    children [ Box { size 0.5 0.4 0.12 } ]
  }
  physics Physics {
    density -1
    mass 15
  }
  controller ""
  name "moonmapper_rover"
}
