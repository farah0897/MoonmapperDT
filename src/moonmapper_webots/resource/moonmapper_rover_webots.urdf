<?xml version="1.0" ?>
<!-- URDF for webots_ros2_driver: plugin + Lidar device config -->
<!-- Robot name in Webots world must be moonmapper_rover -->
<robot name="moonmapper_rover">
  <webots>
    <!-- 2D LiDAR: publishes /scan (LaserScan) when single-layer -->
    <device reference="lidar" type="Lidar">
      <ros>
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
        <alwaysOn>true</alwaysOn>
      </ros>
    </device>
    <!-- Custom plugin: cmd_vel -> motors, odom, TF -->
    <plugin type="moonmapper_webots.moonmapper_driver.MoonmapperDriver" />
  </webots>
</robot>
