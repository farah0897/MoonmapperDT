<?xml version="1.0" ?>
<!--
  MoonMapper maane-arena for Gazebo Sim 8.

  Samme dimensjoner og konsept som Unity-arenaet (se Unity_arena_setup.md):
    * Avgrenset testarea: 5 m x 4 m = 20 m^2
    * Flat moonregolith-bakke (graatoner) med stor ytre plate (20 x 20 m)
      slik at kameraer ikke ser "kanten av verden"
    * Hard, uoppliftet solbelysning (direksjonal), svakt ambient
    * Moerk, nesten svart scene-bakgrunn (ingen atmosfaere paa maanen)
    * Fire graa hjoerne-stolper for aa markere arenaet
    * Lave, usynlige colliderveggar langs kanten saa roveren ikke
      kjoerer ut (matcher ArenaBoundary.cs i Unity)
    * Et knippe maanestein-lignende hindringer inne i arenaet

  Skalaen er bevart fra Unity-oppsettet (5x4 m). Roveren i URDF-en
  er ~5 cm, saa arenaet er stort i forhold til roveren — helt som
  planlagt for maanemiljoet.
-->
<sdf version="1.11">
  <world name="moon_arena">

    <!-- Fysikk: Bullet (raycast-støtte + robust kollisjoner i gz-sim8) -->
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Gazebo Sim 8 system-plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Maanegravitasjon (1.62 m/s^2).
         Bruk -9.81 hvis du heller vil ha jord-gravitasjon for
         enklere testing av kontroll. -->
    <gravity>0 0 -1.62</gravity>

    <!-- Moerk "rom-bakgrunn" uten atmosfaere-scatter. -->
    <scene>
      <ambient>0.03 0.03 0.04 1</ambient>
      <background>0.015 0.015 0.02 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <!-- Minimalt blaa-graa himmel saa horisonten ikke er helt
             svart. Gazebo Sim 8 har ikke HDRI-kube som Unity, saa
             vi faar en "flat" natt-himmel. -->
      </sky>
    </scene>

    <!-- Sol: skarp direksjonal kilde, ingen atmosfaere.
         Retning valgt saa skygger legger seg pent paa x/y-aksene. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>100</range>
        <linear>0.0</linear>
        <constant>1.0</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -1.0</direction>
    </light>

    <!-- Svak "fyll" saa skyggesiden ikke er helt svart, matcher
         en svak jordlysning. -->
    <light type="directional" name="earthshine">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.08 0.09 0.12 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.5 -0.3 -1.0</direction>
    </light>

    <!-- ================================================================
         BAKKE - stor ytre plate i regolith-graa
         ================================================================ -->
    <model name="regolith_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <surface>
            <friction>
              <!-- Hoy friksjon - regolith er veldig grynete. -->
              <ode><mu>1.3</mu><mu2>1.3</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.32 0.30 0.28 1</ambient>
            <diffuse>0.55 0.52 0.48 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         ARENA-GRENSER: usynlige vegger (5 m x 4 m)
         Tykkelse 0.02, hoyde 0.15 (15 cm) - holder en 5 cm rover inne.
         ================================================================ -->
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0.0 2.0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5.0 0.02 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>5.0 0.02 0.15</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.55 0.15</ambient>
            <diffuse>0.6 0.6 0.65 0.15</diffuse>
          </material>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0.0 -2.0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>5.0 0.02 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>5.0 0.02 0.15</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.55 0.15</ambient>
            <diffuse>0.6 0.6 0.65 0.15</diffuse>
          </material>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>
    <model name="arena_wall_east">
      <static>true</static>
      <pose>2.5 0.0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.02 4.0 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.02 4.0 0.15</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.55 0.15</ambient>
            <diffuse>0.6 0.6 0.65 0.15</diffuse>
          </material>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>
    <model name="arena_wall_west">
      <static>true</static>
      <pose>-2.5 0.0 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.02 4.0 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.02 4.0 0.15</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.55 0.15</ambient>
            <diffuse>0.6 0.6 0.65 0.15</diffuse>
          </material>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>

    <!-- Fire hjoerne-stolper saa arenaet er synlig for brukeren,
         matcher spawnCornerPosts i ArenaBoundary.cs. -->
    <model name="corner_post_ne">
      <static>true</static>
      <pose>2.5 2.0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.7 0.2 1</ambient>
            <diffuse>1.0 0.85 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="corner_post_nw">
      <static>true</static>
      <pose>-2.5 2.0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.7 0.2 1</ambient>
            <diffuse>1.0 0.85 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="corner_post_se">
      <static>true</static>
      <pose>2.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.7 0.2 1</ambient>
            <diffuse>1.0 0.85 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="corner_post_sw">
      <static>true</static>
      <pose>-2.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.03</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.7 0.2 1</ambient>
            <diffuse>1.0 0.85 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         MAANESTEIN-HINDRINGER
         Skalerer til en ~5 cm rover med hjul-radius ~7 mm.
         Plassert slik at det er klart startomraade rundt origo.
         ================================================================ -->
    <model name="moon_rock_1">
      <static>true</static>
      <pose>0.25 0.15 0.01 0 0 0.4</pose>
      <link name="link">
        <collision name="c">
          <geometry><sphere><radius>0.012</radius></sphere></geometry>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.012</radius></sphere></geometry>
          <material>
            <ambient>0.25 0.24 0.22 1</ambient>
            <diffuse>0.40 0.38 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="moon_rock_2">
      <static>true</static>
      <pose>-0.20 0.30 0.008 0 0 0.9</pose>
      <link name="link">
        <collision name="c">
          <geometry><sphere><radius>0.009</radius></sphere></geometry>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.009</radius></sphere></geometry>
          <material>
            <ambient>0.22 0.21 0.20 1</ambient>
            <diffuse>0.35 0.33 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="moon_rock_3">
      <static>true</static>
      <pose>0.35 -0.22 0.015 0 0 1.3</pose>
      <link name="link">
        <collision name="c">
          <geometry><sphere><radius>0.018</radius></sphere></geometry>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material>
            <ambient>0.28 0.27 0.25 1</ambient>
            <diffuse>0.45 0.43 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="moon_rock_4">
      <static>true</static>
      <pose>-0.35 -0.15 0.007 0 0 2.1</pose>
      <link name="link">
        <collision name="c">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.008</radius></sphere></geometry>
          <material>
            <ambient>0.20 0.19 0.18 1</ambient>
            <diffuse>0.32 0.30 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- En lav krater-kant som rocker-bogie-utfordring. -->
    <model name="crater_rim">
      <static>true</static>
      <pose>0.60 0.00 0.006 0 -0.18 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.10 0.20 0.004</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.10 0.20 0.004</size></box></geometry>
          <material>
            <ambient>0.30 0.28 0.26 1</ambient>
            <diffuse>0.48 0.45 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- En liten regolith-haug (testrampa). -->
    <model name="regolith_mound">
      <static>true</static>
      <pose>-0.60 0.00 0.006 0 0.18 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.10 0.20 0.004</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.10 0.20 0.004</size></box></geometry>
          <material>
            <ambient>0.32 0.30 0.28 1</ambient>
            <diffuse>0.52 0.49 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
