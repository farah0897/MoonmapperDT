<?xml version="1.0" ?>
<!--
  Test-verden for MoonMapper rocker-bogie.

  Inneholder:
    * flatt gulv
    * en bokse-hindring til hjul-klatre-test
    * en rampe
    * en steinete ujevn patch (knobby terrain)

  Kjoerer med standard Gazebo Sim 8 physics/sensors/render systems.
-->
<sdf version="1.11">
  <world name="rocker_bogie_test">

    <!-- Fysikk: sma tidssteg = ro i passive ledd -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Bakke -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.35 0.32 0.28 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Skalert ned for en ~5cm rover med ~7mm hjul.
         Hinderhoeyde ~3mm = mindre enn hjulradius men stor nok til
         aa utfordre rocker-bogien. -->
    <model name="step_obstacle">
      <static>true</static>
      <pose>0.08 0.0 0.0015 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.02 0.06 0.003</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.02 0.06 0.003</size></box></geometry>
          <material><diffuse>0.5 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rampe, 15 grader -->
    <model name="ramp">
      <static>true</static>
      <pose>0.18 0.0 0.006 0 -0.2618 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.08 0.06 0.003</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.08 0.06 0.003</size></box></geometry>
          <material><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Smaa steiner for ujevn kontakt -->
    <model name="rock_1">
      <static>true</static>
      <pose>0.04 0.02 0.0020 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.0025</radius></sphere></geometry></collision>
        <visual    name="v"><geometry><sphere><radius>0.0025</radius></sphere></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>0.05 -0.02 0.0020 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.002</radius></sphere></geometry></collision>
        <visual    name="v"><geometry><sphere><radius>0.002</radius></sphere></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>0.06 0.008 0.0020 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.0025</radius></sphere></geometry></collision>
        <visual    name="v"><geometry><sphere><radius>0.0025</radius></sphere></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
