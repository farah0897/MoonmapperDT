    </actuator>
  </transmission>

  <transmission name="wheel_r2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_r2_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="wheel_r2_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="wheel_r3_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_r3_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="wheel_r3_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

<link name="rocker_bogie_diff_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://moonmapper_description/meshes/visual/rocker_bogie_diff_link.stl"
            scale="1 1 1"/>
    </geometry>
    <material name="moonmapper_dark_gray">
      <color rgba="0.35 0.35 0.35 1.0"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://moonmapper_description/meshes/visual/rocker_bogie_diff_link.stl"
            scale="1 1 1"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.005"/>
    <inertia ixx="1e-7" ixy="0" ixz="0"
             iyy="1e-7" iyz="0"
             izz="1e-7"/>
  </inertial>
</link>

<!-- ===============================================================
     VISUELL "TIP"-GEOMETRI FOR PUSHRODS VED DIFF-BEAM

     URDF kan ikke representere den lukkede løkken (stang-tupp <-> beam-ende).
     For å unngå at stang_endene ser ut som de "stikker ut", legger vi inn
     to små endebeslag som er barn av diff-beamet. Disse følger diffens yaw
     (rocker_bogie_diff_joint), slik at den visuelle mekanikken ser korrekt ut
     selv om den fysiske koblingen håndheves av pluginen via rocker-constraint.

     Plassering bruker samme halvlengde som dokumentert i diff-kommentaren:
       diff-stav halvlengde ≈ 0.0747 m langs Y i diff-link frame.
     =============================================================== -->
<link name="stang_left_tip_link">
  <!-- Bruk primitiv visual her: mesh-filene hengsel_diff_* finnes ikke i
       moonmapper_description/meshes/visual i denne repo-versjonen. -->
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.004"/>
    </geometry>
    <material name="moonmapper_dark_gray">
      <color rgba="0.35 0.35 0.35 1.0"/>
    </material>
  </visual>
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.001"/>
    <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
  </inertial>
</link>
<joint name="stang_left_tip_joint" type="fixed">
  <parent link="rocker_bogie_diff_link"/>
  <child link="stang_left_tip_link"/>
  <origin xyz="0.0 0.0747 0.0" rpy="0 0 0"/>
</joint>

<link name="stang_right_tip_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.004"/>
    </geometry>
    <material name="moonmapper_dark_gray">
      <color rgba="0.35 0.35 0.35 1.0"/>
    </material>
  </visual>
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.001"/>
    <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
  </inertial>
</link>
<joint name="stang_right_tip_joint" type="fixed">
  <parent link="rocker_bogie_diff_link"/>
  <child link="stang_right_tip_link"/>
  <origin xyz="0.0 -0.0747 0.0" rpy="0 0 0"/>
</joint>

<!-- Walking-beam staven paa toppen av chassiset.
     Kinematisk utledning (virtuelt ball-link mellom push-arm-tupp og stav-ende):
       push-arm-tupp i rocker-frame: (-0.106, -0.001, +0.061) m
       diff-stav halvlengde:         0.0747 m (Y-akse)
       Linearisert X-bevegelse:
         d_arm = 0.061 * theta_R   (rotasjon om Y, cos-ledd forsvinner for smaa vinkler)
         d_bar = 0.0747 * phi      (yaw om Z)
         => phi = (0.061 / 0.0747) * theta_R = 0.82 * theta_R
     I Gazebo overstyres dette av RockerBogieDifferential-plugin-en. -->
<joint name="rocker_bogie_diff_joint" type="revolute">
  <parent link="feste_rocker_karosseri_link"/>
  <child link="rocker_bogie_diff_link"/>
  <origin xyz="0.000012 0.000001 0.014" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <!-- Diff-staven er en lett, kosmetisk link som PD-drives i Gazebo.
       Høy URDF-damping/friction her kan låse hele rocker-systemet indirekte.
       Hold den derfor myk; stabilisering skjer i pluginens PD-gains. -->
  <dynamics damping="0.02" friction="0.002"/>
  <!-- Ikke la diff-leddet mettes på lav velocity-limit; det er en "kosmetisk"
       ledd som må kunne følge pluginens target uten å klippe hastigheten. -->
  <limit lower="${-90*deg}" upper="${90*deg}" effort="100" velocity="10.0"/>
  <xacro:if value="$(arg enable_urdf_mimic)">
    <mimic joint="rocker_right_joint" multiplier="0.82" offset="0.0"/>
  </xacro:if>
</joint>

<!-- === Tak (skroghette over kjernen av chassiset) === -->
<link name="tak_liten_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://moonmapper_description/meshes/visual/Tak_liten_link.stl"
            scale="1 1 1"/>
    </geometry>
    <material name="moonmapper_light_gray">
      <color rgba="0.7 0.7 0.7 1.0"/>
    </material>
  </visual>
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.010"/>
    <inertia ixx="1e-7" ixy="0" ixz="0"
             iyy="1e-7" iyz="0"
             izz="1e-7"/>
  </inertial>
</link>
<joint name="tak_liten_joint" type="fixed">
  <parent link="base_link"/>
  <child link="tak_liten_link"/>
  <origin xyz="0.100194 -0.000939 0.079219" rpy="0 0 0"/>
</joint>

<!-- === Feste mellom karosseri og rocker-aksel (chassis-braket) === -->
<link name="feste_rocker_karosseri_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://moonmapper_description/meshes/visual/feste_rocker_til_karosseri_link.stl"
            scale="1 1 1"/>
    </geometry>
    <material name="moonmapper_dark_gray">
      <color rgba="0.35 0.35 0.35 1.0"/>
    </material>
  </visual>
