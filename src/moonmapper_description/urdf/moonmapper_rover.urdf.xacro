    <child link="wheel_l3_link"/>
    <origin xyz="0.083864 0.000953 -0.048213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.002"/>
    <limit effort="0.5" velocity="30.0"/>
