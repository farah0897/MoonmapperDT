  <!-- ===============================================================
       Transmissions (6 hjulmotorer)
       ===============================================================
       Disse gjør hjulene "actuated" i URDF (brukes av ros2_control / plugins).
       Mekanisk reduksjon settes til 1:1 som default. -->

  <transmission name="wheel_l1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_l1_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
