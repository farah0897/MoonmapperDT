<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="moonmapper">

  <!-- Author joint limits in degrees; URDF consumes radians -->
  <xacro:property name="deg" value="0.017453292519943295"/> <!-- pi/180 -->
  <!-- NOTE: Keeping this file argument-free for simple launching. -->
  <!-- URDF mimic-tagging is intended ONLY for RViz / kinematic visualization.
       In Gazebo, mimic can fight physics constraints / plugins and stiffen the suspension. -->
  <xacro:arg name="enable_urdf_mimic" default="true"/>

  <!-- Base footprint frame for RViz / navigation stacks -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/robot_base.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <!-- Stabil sim-collision: primitiv boks i stedet for detaljert STL.
           Hindrer at skarpe detaljer tar bakken og “tipper” roveren før
           rocker/bogie får jobbe. Størrelse fra notat i filen: 48x25x18mm. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.048 0.025 0.018"/>
      </geometry>
    </collision>
    <!-- Gazebo krever inertial paa enhver dynamisk link.
         Verdier skalert for en ~5cm rover-chassis (mesh-boks 48x25x18mm). -->
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0010" ixy="0" ixz="0"
               iyy="0.0012" iyz="0"
               izz="0.0015"/>
    </inertial>
  </link>


  <!-- =====================================================================
       ROCKER-BOGIE-SUSPENSJON  (mekanisk korrekt hierarki)
       =====================================================================

       DOF-oversikt:
         - rocker_right_joint  (revolute, Y)    [eneste rocker-pivot hoeyre]
         - rocker_left_joint   (revolute, Y)    [eneste rocker-pivot venstre]
         - bogie_right_joint   (revolute, Y)    [bogie relativt til rocker]
         - bogie_left_joint    (revolute, Y)    [bogie relativt til rocker]
         - wheel_[lr][123]_joint (continuous, Y)

       Feste-braketten + mellomstykket + stang er STIV-SVEISET til rockeren
       (fixed). Dette er fysisk korrekt: push-arm-strukturen på toppen av
       en rocker har ingen egen frihetsgrad relativt til rockeren.

       Den lukkede sloeyfen mellom stang-tuppen og diff-staven i chassiset
       lar seg IKKE representere i URDF (trestruktur). Vi løser det ved:
         * RViz: mimic-tagger på rocker_left_joint og rocker_bogie_diff_joint
         * Gazebo: RockerBogieDifferential-pluginen (PD-constraint)
       ===================================================================== -->

  <!-- =====================================================================
       HOEYRE SIDE
       ===================================================================== -->

  <!-- Rocker (revolute) festet direkte på chassiset.
       Origin = gammel "feste_rocker_bogie" fixed-offset + gammel rocker-offset:
         (0.014227,-0.065999,0.021756) + (-0.013717,-0.001277,-0.007986)
         = (0.000510,-0.067276,0.013770) -->
  <link name="rocker_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/rocker_right_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/rocker_right_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Thin rod om pivot: I=mL^2/3, L=0.16m, m=0.08 -> 6.8e-4.
           Konservativ 4e-4 for aa unngaa integrator-eksplosjoner. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="2.0e-5" ixy="0" ixz="0"
               iyy="4.0e-4" iyz="0"
               izz="4.0e-4"/>
    </inertial>
  </link>
  <joint name="rocker_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rocker_right_link"/>
    <origin xyz="0.014227 -0.065999 0.021756" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.005"/>
    <limit lower="-0.133" upper="0.133" effort="100" velocity="6.0"/>
  </joint>


  <!-- Mellomstykket er sveiset fast i toppen av braketten. -->
  <link name="feste_mellom_feste_og_stang_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/feste_mellom_feste_og_stang_right_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0"
               iyy="1e-8" iyz="0"
               izz="1e-8"/>
    </inertial>
  </link>
  <joint name="feste_mellom_feste_og_stang_right_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="feste_mellom_feste_og_stang_right_link"/>
    <origin xyz="0.013913 -0.067245 0.076373" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <xacro:if value="$(arg enable_urdf_mimic)">
      <mimic joint="rocker_bogie_diff_joint" multiplier="0.05" offset="0.0"/>
    </xacro:if>
     <limit lower="${-1*deg}" upper="${1*deg}" effort="50" velocity="3.0"/>
  </joint>

  <!-- Staget er sveiset fast i mellomstykket. Tupp-enden som fysisk skal
       kobles til rocker_bogie_diff_link holdes kun visuelt i naerheten;
       URDF-treet bryter sloeyfen her. -->
  <link name="stang_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/stang_right_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0"
               iyy="1e-8" iyz="0"
               izz="1e-8"/>
    </inertial>
  </link>
  <joint name="stang_right_joint" type="prismatic">
    <parent link="feste_mellom_feste_og_stang_right_link"/>
    <child link="stang_right_link"/>
    <origin xyz="-0.101730 -0.000140 0.000033" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <xacro:if value="$(arg enable_urdf_mimic)">
      <mimic joint="feste_mellom_feste_og_stang_right_joint" multiplier="0.05" offset="0.0"/>
    </xacro:if>
    <limit lower="${-1*deg}" upper="${1*deg}" effort="50" velocity="3.0"/>
  </joint>

  <!-- Bogie (revolute, Y) parentet paa ROCKEREN, ikke paa braketten.
       Origin = (gammel bogie-in-feste-frame) - (gammel rocker-in-feste-frame)
         = (0.013841,-0.001255,-0.008003) - (-0.013717,-0.001277,-0.007986)
         = (0.027558, 0.000022, -0.000017) -->
  <link name="bogie_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/bogie_right_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/bogie_right_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Thin rod om pivot: L=0.30m, m=0.05 -> I=m*L^2/12 = 3.75e-4.
           Vi bruker 1.5e-4 som kompromiss (stabil + rask response). -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.2e-5" ixy="0" ixz="0"
               iyy="1.5e-4" iyz="0"
               izz="1.5e-4"/>
    </inertial>
  </link>
  <joint name="bogie_right_joint" type="revolute">
    <parent link="rocker_right_link"/>
    <child link="bogie_right_link"/>
    <origin xyz="0.087545 -0.025322 -0.050495" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.003"/>
    <limit lower="${-40*deg}" upper="${40*deg}" effort="100" velocity="6.0"/>
  </joint>

  <!-- Hoeyre hjul: r1 paa rocker, r2+r3 paa bogie. Continuous (ingen limits). -->
  <link name="wheel_r1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r1_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r1_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="6e-7" ixy="0" ixz="0"
               iyy="6e-7" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>
  <joint name="wheel_r1_joint" type="continuous">
    <parent link="rocker_right_link"/>
    <child link="wheel_r1_link"/>
    <origin xyz="-0.157986 -0.023379 -0.091195" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.002"/>
    <limit effort="0.5" velocity="30.0"/>
  </joint>

  <!-- Motor for wheel_r1 -->
  <link name="motor_r1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/motor_r1_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="motor_r1_joint" type="fixed">
    <parent link="wheel_r1_link"/>
    <child link="motor_r1_link"/>
    <origin xyz="0.005889 0.016158 0.003605" rpy="0 0 0"/>
  </joint>

  <link name="wheel_r2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r2_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r2_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="6e-7" ixy="0" ixz="0"
               iyy="6e-7" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>
  <joint name="wheel_r2_joint" type="continuous">
    <parent link="bogie_right_link"/>
    <child link="wheel_r2_link"/>
    <origin xyz="-0.087682 -0.001314 -0.050479" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.002"/>
    <limit effort="0.5" velocity="30.0"/>
  </joint>

  <!-- Motor for wheel_r2 -->
  <link name="motor_r2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/motor_r2_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="motor_r2_joint" type="fixed">
    <parent link="wheel_r2_link"/>
    <child link="motor_r2_link"/>
    <origin xyz="0.007126 0.015908 0.004629" rpy="0 0 0"/>
  </joint>

  <link name="wheel_r3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r3_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_r3_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="6e-7" ixy="0" ixz="0"
               iyy="6e-7" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>
  <joint name="wheel_r3_joint" type="continuous">
    <parent link="bogie_right_link"/>
    <child link="wheel_r3_link"/>
    <origin xyz="0.083643 -0.001174 -0.048394" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.002"/>
    <limit effort="0.5" velocity="30.0"/>
  </joint>

  <!-- Motor for wheel_r3 -->
  <link name="motor_r3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/motor_r3_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="motor_r3_joint" type="fixed">
    <parent link="wheel_r3_link"/>
    <child link="motor_r3_link"/>
    <origin xyz="-0.007557 0.015899 0.003831" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       VENSTRE SIDE (speilbilde av hoeyre)
       ===================================================================== -->

  <!-- Rocker venstre. Origin = (0.014252,0.064048,0.021830)+(-0.013851,0.001264,-0.007984)
         = (0.000401, 0.065312, 0.013846).
       I RViz mimikkes qL = -qR slik at walking-beam-visualiseringen stemmer.
       I Gazebo er mimic skrudd AV; RockerBogieDifferential-pluginen enforcer
       sum-constrainten dynamisk i stedet. -->
  <link name="rocker_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/rocker_left_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/rocker_left_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="2.0e-5" ixy="0" ixz="0"
               iyy="4.0e-4" iyz="0"
               izz="4.0e-4"/>
    </inertial>
  </link>
  <joint name="rocker_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rocker_left_link"/>
    <origin xyz="0.014252 0.064048 0.021830" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.005"/>
    <limit lower="-0.133" upper="0.133" effort="100" velocity="6.0"/>
    <xacro:if value="$(arg enable_urdf_mimic)">
      <mimic joint="rocker_right_joint" multiplier="-1.0" offset="0.0"/>
    </xacro:if>
  </joint>


  <link name="feste_mellom_feste_og_stang_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/feste_mellom_feste_og_stang_left_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0"
               iyy="1e-8" iyz="0"
               izz="1e-8"/>
    </inertial>
  </link>
  <joint name="feste_mellom_feste_og_stang_left_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="feste_mellom_feste_og_stang_left_link"/>
    <origin xyz="0.013977 0.064006 0.076371" rpy="0 0 0"/>
    <xacro:if value="$(arg enable_urdf_mimic)">
      <mimic joint="rocker_bogie_diff_joint" multiplier="0.05" offset="0.0"/>
    </xacro:if>
    <axis xyz="1 0 0"/>
    <limit lower="${-1*deg}" upper="${1*deg}" effort="50" velocity="3.0"/>
  </joint>

  <link name="stang_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/stang_left_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-8" ixy="0" ixz="0"
               iyy="1e-8" iyz="0"
               izz="1e-8"/>
    </inertial>
  </link>
  <joint name="stang_left_joint" type="prismatic">
    <parent link="feste_mellom_feste_og_stang_left_link"/>
    <child link="stang_left_link"/>
    <origin xyz="-0.101903 0.001198 0.000110" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <xacro:if value="$(arg enable_urdf_mimic)">
      <mimic joint="feste_mellom_feste_og_stang_left_joint" multiplier="0.05" offset="0.0"/>
    </xacro:if>
    <limit lower="${-1*deg}" upper="${1*deg}" effort="50" velocity="3.0"/>
  </joint>

  <!-- Bogie venstre. Origin = (0.013707,0.001287,-0.008001)-(-0.013851,0.001264,-0.007984)
         = (0.027558, 0.000023, -0.000017) -->
  <link name="bogie_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/bogie_left_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/bogie_left_link.stl"
              scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.2e-5" ixy="0" ixz="0"
               iyy="1.5e-4" iyz="0"
               izz="1.5e-4"/>
    </inertial>
  </link>
  <joint name="bogie_left_joint" type="revolute">
    <parent link="rocker_left_link"/>
    <child link="bogie_left_link"/>
    <origin xyz="0.087063 0.025935 -0.050644" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.003"/>
    <limit lower="${-40*deg}" upper="${40*deg}" effort="100" velocity="6.0"/>
  </joint>

  <!-- Venstre hjul: l1 paa rocker, l2+l3 paa bogie. Continuous (ingen limits). -->
  <link name="wheel_l1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://moonmapper_description/meshes/visual/wheel_l1_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
