  </link>
  <joint name="bogie_right_joint" type="revolute">
    <parent link="rocker_right_link"/>
    <child link="bogie_right_link"/>
    <origin rpy="0 0 0" xyz="-0.008727 0.002407 -0.006584"/>
    <axis xyz="0 1 0"/>
    <!-- Near-null statisk friksjon slik at bogien returnerer til flat
         posisjon naar begge hjul faar bakkekontakt igjen (ekte bogie har
