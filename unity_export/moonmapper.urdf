<!-- Entry-point xacro for MoonMapper rover -->
<robot name="moonmapper">
  <!-- pi/180 -->
  <link name="world"/>
  <joint name="world_to_base_footprint" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/robot_base.stl" scale="1 1 1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/robot_base.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <!-- Gazebo krever inertial paa enhver dynamisk link.
         Verdier skalert for en ~5cm rover-chassis (mesh-boks 48x25x18mm). -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.005"/>
      <mass value="2.0"/>
      <inertia ixx="0.0010" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0015"/>
    </inertial>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="rocker_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/rocker_right_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/rocker_right_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="rocker_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rocker_right_link"/>
    <origin rpy="0 0 0" xyz="-0.001174 0.014653 0.003683"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="2.0" friction="0.15"/>
    <limit effort="100" lower="-0.5235987755982988" upper="0.5235987755982988" velocity="2.0"/>
  </joint>
  <!-- Bogie right -->
  <link name="bogie_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/bogie_right_link.stl" scale="1 1 1"/>
      </geometry>
      <material name="moonmapper_dark_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
